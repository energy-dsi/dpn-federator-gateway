<configuration>

    <!-- Console appender using OtelJsonLayout: emits single-line OTel JSON logs
         (timestamp, severity_number/text, body, resource.*, attributes.*, and
         conditional trace_id/span_id when inside an active span). -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="uk.gov.dbt.ndtp.federator.common.logging.OtelJsonLayout">
                <!-- serviceName falls back to OTEL_SERVICE_NAME env var if blank -->
                <serviceName></serviceName>
                <serviceVersion></serviceVersion>
                <sourceRoot>uk.gov.dbt.ndtp.federator</sourceRoot>
            </layout>
        </encoder>
    </appender>

    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="CONSOLE"/>
        <neverBlock>true</neverBlock>
    </appender>


    <appender name="OTEL_MDC" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </appender>
    <appender name="OpenTelemetry" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureCodeAttributes>true</captureCodeAttributes>
        <captureMdcAttributes>*</captureMdcAttributes>
        <!-- Forward SLF4J key-value pairs (event.name, component.name, heartbeat.*, etc.)
             to the collector, matching what OtelJsonLayout writes to the console. Without
             this, .addKeyValue(...) attributes are dropped on the OTLP path. -->
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureLoggerContext>true</captureLoggerContext>
    </appender>

    <logger name="uk.gov.dbt.ndtp.federator" level="DEBUG"/>

    <!-- DSI FIX: root previously referenced both ASYNC_CONSOLE directly AND OTEL_MDC (which
         itself forwards to ASYNC_CONSOLE), causing every event to reach CONSOLE/OtelJsonLayout
         twice - once undecorated, once via OTEL_MDC's trace_id/span_id/trace_flags MDC
         injection. OTEL_MDC already delivers to ASYNC_CONSOLE, so the direct ref is removed. -->
    <root level="INFO">
        <appender-ref ref="OTEL_MDC"/>
        <appender-ref ref="OpenTelemetry"/>
    </root>

</configuration>
