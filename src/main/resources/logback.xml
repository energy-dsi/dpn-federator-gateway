<configuration>

    <!-- Console appender: PLAIN TEXT pattern for human-readable stdout logs - reverted to the
         pre-OTel-telemetry format (matches src/test/resources/logback-test.xml), with trace_id/
         span_id appended so logs stay correlatable across federator-server/federator-client
         without needing to go to the collector. Structured OTel JSON is no longer written to
         stdout - it is still captured, in full OTel format, separately via the "OpenTelemetry"
         appender below, which exports complete OTel log records (trace context,
         event.name/component.name/heartbeat.* attributes, code location, etc.) via OTLP to the
         collector. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [trace_id=%X{trace_id:-}, span_id=%X{span_id:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="CONSOLE"/>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- Populates MDC with trace_id/span_id/trace_flags from the active span (if any) before the
         event reaches CONSOLE's pattern above, which reads them via %X{...}. Only feeds the
         stdout path - it has no effect on the OpenTelemetry/OTLP appender below, which reads
         trace context directly from the active Span via the OTel Context API regardless. -->
    <appender name="OTEL_MDC" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </appender>

    <appender name="OpenTelemetry" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureCodeAttributes>true</captureCodeAttributes>
        <captureMdcAttributes>*</captureMdcAttributes>
        <!-- Forward SLF4J key-value pairs (event.name, component.name, heartbeat.*, etc.)
             to the collector. Without this, .addKeyValue(...) attributes are dropped on the
             OTLP path. -->
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureLoggerContext>true</captureLoggerContext>
    </appender>

    <logger name="uk.gov.dbt.ndtp.federator" level="DEBUG"/>

    <!-- Root fans out to exactly two independent destinations:
         - OTEL_MDC -> ASYNC_CONSOLE: plain-text to stdout, now WITH trace_id/span_id (via MDC).
         - OpenTelemetry: full OTel-format log record, via OTLP, to the collector.
         These are two separate delivery chains reading the same underlying event, so there is
         no duplication - each event reaches stdout exactly once and the collector exactly once. -->
    <root level="INFO">
        <appender-ref ref="OTEL_MDC"/>
        <appender-ref ref="OpenTelemetry"/>
    </root>

</configuration>
